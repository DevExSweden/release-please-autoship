        "test:watch": "vitest"
    },
    "dependencies": {
        "@actions/core": "^2.0.2",
        "@slack/web-api": "^7.3.4"
    },
    "devDependencies": {
        "@types/node": "^25.0.6",
        "@vercel/ncc": "^0.38.4",
        "typescript": "^5.6.3",
        "vitest": "^4.0.15"
    }
}


