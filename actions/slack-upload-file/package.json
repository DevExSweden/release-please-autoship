{
    "name": "slack-upload-file",
    "version": "1.0.0",
    "private": true,
    "description": "GitHub Action that uploads a file to Slack using files.uploadV2",
    "main": "dist/index.js",
    "license": "MIT",
    "scripts": {
        "build": "npx ncc build src/index.ts -o dist",
