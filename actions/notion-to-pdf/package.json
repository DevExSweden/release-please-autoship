{
    "name": "notion-to-pdf",
    "version": "1.0.0",
    "private": true,
    "description": "GitHub Action that exports a Notion page to a PDF file",
    "main": "dist/index.js",
    "license": "MIT",
    "scripts": {
        "build": "npx ncc build src/index.ts -o dist",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@actions/core": "^2.0.2",
        "@notionhq/client": "^5.13.0",
        "playwright-core": "^1.49.0"
    },
    "devDependencies": {
        "@types/node": "^25.0.10",
        "@vercel/ncc": "^0.38.3",
        "typescript": "^6.0.3",
        "vitest": "^4.0.15"
    }
}


