{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": false,
    "types": []
  },
  "include": ["src/**/*", "__tests__/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}


